# Copia in .env e .env.local (progetto Google: rewavier-app)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_EXPO_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# Copia in .env.ftp per VAI (sito privacy / supporto / landing)
# Se manca, lo script usa l’FTP Eventi già configurato su questo Mac.
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=ReWavier
FTP_PUBLIC_URL=https://eventi.musicproeventi.it/ReWavier/
