{
  "expo": {
    "name": "ReWavier",
    "slug": "rewavier",
    "scheme": "rewavier",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0D0D0F",
    "splash": {
      "backgroundColor": "#0D0D0F",
      "resizeMode": "contain"
    },
    "primaryColor": "#FF6B35",
    "description": "Ascolta un audio, metti in pausa e annota il momento esatto sulla waveform.",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "app.rewavier",
      "buildNumber": "46",
      "usesIcloudStorage": true,
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.app.rewavier"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.app.rewavier"
        ],
        "com.apple.developer.icloud-services": [
          "CloudDocuments"
        ]
      },
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "LSApplicationCategoryType": "public.app-category.music",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "it",
        "NSMicrophoneUsageDescription": "ReWavier usa il microfono solo quando registri una bozza musicale.",
        "UIUserInterfaceStyle": "Dark",
        "NSUbiquitousContainers": {
          "iCloud.app.rewavier": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerSupportedFolderLevels": "Any",
            "NSUbiquitousContainerName": "ReWavier"
          }
        }
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "app.rewavier",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "ReWavier usa il microfono solo quando registri una bozza musicale."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "ReWavier usa il microfono solo quando registri una bozza musicale."
        }
      ],
      [
        "@oleg_svetlichnyi/expo-icloud-storage",
        {
          "containerIdentifier": "iCloud.app.rewavier",
          "containerName": "ReWavier"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0D0F"
        }
      ]
    ],
    "extra": {
      "googleIosClientId": "1049963169218-o6tcahpfsdijj2lm811bmjs4vjaglb7v.apps.googleusercontent.com",
      "googleExpoIosClientId": "1049963169218-gpj1pb8omtfhuv76npnhjnsshkqc970g.apps.googleusercontent.com",
      "googleWebClientId": "1049963169218-k8i1dmlbsn1nqrv393u8pp111v7v2efc.apps.googleusercontent.com",
      "eas": {
        "projectId": "ac1cc991-f41d-4b45-adcb-bc574afbce3c"
      }
    },
    "owner": "musicproeventi"
  }
}
